{
  "info": {
    "_postman_id": "22be5695-dc2c-481a-b32d-2b99055ac102",
    "name": "Employee API",
    "description": "Create and retrieve employees from the local FastAPI service. Start with `cd fastApi && uvicorn main:app --reload --port 8001`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8001"
    },
    {
      "key": "employeeId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "List employees",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/employees"
      }
    },
    {
      "name": "Get employee by ID",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/employees/{{employeeId}}"
      }
    },
    {
      "name": "Create employee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 7,\n  \"name\": \"Sam Lee\",\n  \"position\": \"Developer\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/employees"
      }
    }
  ]
}
